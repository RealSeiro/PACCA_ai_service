# 이 파일을 복사해서 .env 로 만들고 값을 채운다. (.env 는 GitHub에 올리지 않음)
DATABASE_URL=postgresql+psycopg://anbu:anbu@localhost:5432/anbu
# 아래 명령으로 만든 값을 넣는다 (이대로 두면 서버가 켜지지 않음): python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=여기에-길고-무작위인-문자열-32자-이상
SCHEDULER_ENABLED=1
# FIREBASE_CREDENTIALS=firebase-service-account.json
# 하루 1번 대화 알림 시각 (모든 사용자 공통, 한국 시간)
DAILY_INVITE_TIME=10:00
# 대화 원문 보관 기간(일). 기억·일상 기록·요약은 이와 무관하게 남음
TURN_RETENTION_DAYS=30
# AI에게 넘기는 최근 기억 수. 0으로 두면 기억 없이 대화 (Baseline 비교 실험용)
MEMORIES_IN_CONTEXT=30
# 1로 두면 팀 검수가 끝난(verified=true) 퀴즈만 출제. 검수 전엔 0
QUIZ_ONLY_VERIFIED=0
